# Browser worker runtime
# .env is loaded automatically by dotenv/config
PORT=8787
HOST=127.0.0.1
LAB_API_TOKEN=replace-with-a-long-random-secret
# Exact hostnames only; include each required TDBK test origin explicitly.
LAB_ALLOWED_HOSTS=tdbk.example.com
LAB_HEADLESS=true

# TDBK application connection (configure on the TDBK API service, not the browser worker)
TDBK_BROWSER_LAB_URL=http://127.0.0.1:8787
TDBK_BROWSER_LAB_TOKEN=replace-with-the-same-worker-secret
