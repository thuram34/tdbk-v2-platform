rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.isMaster == true;
    }

    function isTenantMember(tenantId) {
      return isSignedIn() && (request.auth.token.tenantId == tenantId || isMasterAdmin());
    }

    // FirebaseIdentityManager writes TDBK roles as a top-level string array.
    // Keep Firestore authorization on that canonical claim; do not read a
    // singular "role" claim that the identity writer does not issue.
    function hasTenantAdminRole() {
      return isSignedIn()
        && ('roles' in request.auth.token)
        && request.auth.token.roles is list
        && request.auth.token.roles.hasAny(['TENANT_ADMIN']);
    }

    // Branch access must be explicit. A missing branch claim is not treated as
    // unrestricted branch access; only tenant administrators and TDBK Master
    // may enumerate/access every branch in a tenant. Branch-scoped principals
    // must carry the exact branchId they are authorized to access.
    function isBranchAuthorized(branchId) {
      return isMasterAdmin() ||
             hasTenantAdminRole() ||
             (isSignedIn() && ('branchId' in request.auth.token) &&
              request.auth.token.branchId != null &&
              request.auth.token.branchId == branchId);
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Sokoni owns this public participant projection independently of TDBK.
    // Public discovery can read only explicitly ACTIVE participant records.
    match /sokoniParticipants/{participantId} {
      allow read: if resource.data.publicationStatus == 'ACTIVE';
      allow create: if isSignedIn()
        && request.resource.data.publicationStatus == 'ACTIVE'
        && request.resource.data.tdbkRelationship == 'NOT_ENROLLED';
      // Owner-management is intentionally not invented in this task.
      allow update, delete: if false;
    }

    // Default Deny Catch-All Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Tenant Isolation Hierarchy (/tenants/{tenantId})
    match /tenants/{tenantId} {
      allow get: if isTenantMember(tenantId) && isValidId(tenantId);
      allow list: if isMasterAdmin();
      allow create, update, delete: if isMasterAdmin();

      // Branch Subcollection
      match /branches/{branchId} {
        allow get, list: if isTenantMember(tenantId) && isValidId(branchId) && isBranchAuthorized(branchId);
        allow write: if isTenantMember(tenantId) && hasTenantAdminRole();
      }

      // Security Audit Logs (Read-only for tenant admin, append-only via server)
      match /security_audits/{auditId} {
        allow get, list: if isTenantMember(tenantId) && hasTenantAdminRole();
        allow write: if false; // Audit logs can only be created by authoritative server runtime
      }

      // No client catch-all. Operational state is server-authoritative and is
      // accessed through authenticated TDBK APIs/Admin SDK. New collections
      // must receive an explicit least-privilege rule before client access.
    }
  }
}
