# Server-side AI configuration.
# In production, inject this through Google Cloud Secret Manager / Cloud Run.
GEMINI_API_KEY=""

# Public application URL used for self-referential links and callbacks.
APP_URL=""

# Google Cloud project configuration.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=

# Demo data is permitted only outside production unless explicitly enabled.
SEED_DEMO_DBKS=false

# Firebase Web Client Configuration.
# These values are intentionally exposed to the browser by Vite.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional paid subscription checkout prices (KES, whole shillings).
# Set authoritative prices in Cloud Run / Secret Manager before enabling paid checkout.
# Never expose these values through VITE_* variables.
TDBK_TIER_PRICE_KES_FOUNDATION=
TDBK_TIER_PRICE_KES_GROWTH=
TDBK_TIER_PRICE_KES_PRO=
TDBK_TIER_PRICE_KES_ENTERPRISE=
