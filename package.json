{
  "name": "tdbk-v2-platform",
  "private": true,
  "version": "2.0.0",
  "description": "Thuram Digital Bridge Kenya (TDBK) V2 — Multi-Tenant Kernel, Blueprint Validation & Experience Platform",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:phase7": "vitest run src/platform/tests/phase7.test.ts",
    "verify:engineering": "bash scripts/verify-engineering.sh",
    "test:phase1": "vitest run src/blueprint/tests/phase1.test.ts",
    "verify:phase1": "bash scripts/verify-phase1.sh",
    "test:capabilities": "vitest run src/capability/tests",
    "verify:capabilities": "bash scripts/verify-capabilities.sh",
    "test:flow": "vitest run src/platform/flow/flowOrchestrator.test.ts",
    "verify:flow": "bash scripts/verify-flow.sh"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
